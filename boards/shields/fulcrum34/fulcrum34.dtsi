#include <dt-bindings/zmk/matrix_transform.h>

/ {

    chosen {
        zephyr,display = &oled;
		zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
		zmk,battery = &vbatt;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <6>;
// | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  |
// | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  |
// | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 |
//               		| SW20 | SW21 |   | SW21 | SW20 |
// | SWDW | SWBK | SWIN | SWUP | SWFW |   | SWBK | SWUP | SWIN | SWFW | SWDW |
//                                        | SWA  | SWB  | SWC  |
        map = <
RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
						RC(3,4) RC(3,5)  RC(3,6) RC(3,7)
RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)  RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10)
                                         RC(5,6) RC(5,7) RC(5,8)
        >;
    };

	kscan0: kscan_composite {
		compatible = "zmk,kscan-composite";
		columns = <10>;
		rows = <6>;
		
		matrix {
			kscan = <&kscan1>;
		};
		
		direct {
			kscan = <&kscan2>;
			row-offset = <5>;
		};
	};	

    kscan1: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        row-gpios
            = <&gpio0 30 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
            , <&gpio0 28 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
            , <&gpio0 2 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
            , <&gpio0 3 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
			, <&gpio0 10 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
            ;
    };
	
	kscan2: kscan_direct {
		compatible = "zmk,kscan-gpio-direct";
		input-gpios
			= <&gpio1 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			;
	};

vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };
	
};

&feather_i2c {
    status = "okay";

    oled: sh1106@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0x62>;
        display-offset = <0x62>;
        multiplex-ratio = <0x7f>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
		reset-gpios;
    };
};